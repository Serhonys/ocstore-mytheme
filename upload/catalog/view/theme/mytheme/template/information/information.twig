{{ header }}
<main class="layout" id="information-information">
  {{ column_left }}
  <div id="content" class="layout-main">
    <ul class="crumbs">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    {{ content_top }}
    <h1>{{ heading_title }}</h1>
    {{ description }}
    {{ content_bottom }}
  </div>
  {{ column_right }}
</main>
{{ footer }}
