<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <base href="{{ base ?: '/' }}" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title ?: heading_title }}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            canvas: '#FAFAFA',
            surface: '#FFFFFF',
            hairline: '#E5E5E5',
            ink: '#111111',
            crimson: '#DC2626',
            forest: '#16A34A',
          }
        }
      }
    }
  </script>

  <style>
    :root {
      --ui-radius: 14px;
      --ui-radius-sm: 10px;
      --ui-border-color: #E5E5E5;
      --ui-border-width: 1px;
      --ui-btn-accent: #111111;
      --ui-btn-accent-hover: #262626;
      --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: #FAFAFA;
      color: #111111;
      overflow-x: hidden;
    }

    .tabular {
      font-variant-numeric: tabular-nums;
    }

    /* Динамические токены интерфейса (управляются из Панели настроек) */
    .ui-card {
      border-radius: var(--ui-radius);
      border-width: var(--ui-border-width);
      border-style: solid;
      border-color: var(--ui-border-color);
      transition: border-radius 0.3s var(--ease-out-expo), border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .ui-control {
      border-radius: var(--ui-radius-sm);
      transition: border-radius 0.3s var(--ease-out-expo), border-color 0.25s ease, background-color 0.25s ease, transform 0.2s ease;
    }

    /* Плавное появление карточек */
    .reveal-card {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.75s var(--ease-out-expo), transform 0.75s var(--ease-out-expo);
    }
    .reveal-card.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Зум фото в галерее */
    .gallery-img {
      transition: transform 0.8s var(--ease-out-expo), filter 0.5s ease;
      will-change: transform, filter;
    }
    .gallery-frame:hover .gallery-img {
      transform: scale(1.03);
    }

    /* Главная кнопка действия с динамическим акцентом и зеленым подтверждением */
    .btn-accent-dynamic {
      background-color: var(--ui-btn-accent);
      border-color: var(--ui-btn-accent);
      position: relative;
      overflow: hidden;
      z-index: 1;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease, border-color 0.3s ease, border-radius 0.3s var(--ease-out-expo);
    }
    .btn-accent-dynamic:hover {
      background-color: var(--ui-btn-accent-hover);
      border-color: var(--ui-btn-accent-hover);
    }
    .btn-accent-dynamic:active {
      transform: scale(0.98);
    }
    .btn-confirmed {
      background-color: #16A34A !important;
      border-color: #16A34A !important;
      transform: scale(1.015);
    }

    /* Стили переключателей (Toggle Switches) в панели настроек */
    .toggle-track {
      width: 40px;
      height: 22px;
      border-radius: 9999px;
      background-color: #E5E5E5;
      position: relative;
      transition: background-color 0.25s var(--ease-out-expo);
      flex-shrink: 0;
    }
    .toggle-thumb {
      width: 16px;
      height: 16px;
      border-radius: 9999px;
      background-color: #FFFFFF;
      position: absolute;
      top: 3px;
      left: 3px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
      transition: transform 0.25s var(--ease-out-expo);
    }
    input:checked + .toggle-track {
      background-color: #16A34A;
    }
    input:checked + .toggle-track .toggle-thumb {
      transform: translateX(18px);
    }

    /* Анимация вкладок */
    @keyframes tabFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .tab-pane-active {
      animation: tabFadeIn 0.35s var(--ease-out-expo) forwards;
    }

    /* Скрытие полосы прокрутки */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="font-sans antialiased selection:bg-[#111111] selection:text-white">
<input type="hidden" id="oc-product-id" value="{{ product_id }}" />
<input type="hidden" id="oc-minimum" value="{{ minimum ?: 1 }}" />

  <!-- ==================== 1. ЛИПКАЯ ШАПКА С ПОИСКОМ, ИЗБРАННЫМ И КОРЗИНОЙ ==================== -->
  <header class="sticky top-0 z-40 bg-[#FAFAFA]/95 backdrop-blur-md border-b border-[#E5E5E5]">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 h-16 flex items-center justify-between gap-4">
      
      <!-- Бренд и навигация -->
      <div class="flex items-center gap-6 lg:gap-8 min-w-0">
        <a href="#" class="font-display font-bold tracking-[0.14em] text-sm uppercase text-[#111111] shrink-0">
          NORDIC FORM
        </a>
        <nav aria-label="Хлебные крошки" class="hidden xl:flex items-center gap-2 text-xs text-neutral-400 truncate">
          <a href="#" class="hover:text-[#111111] transition-colors">Каталог</a>
          <span>/</span>
          <a href="#" class="hover:text-[#111111] transition-colors">Мебель</a>
          <span>/</span>
          <a href="#" class="hover:text-[#111111] transition-colors">Лаунж-кресла</a>
          <span>/</span>
          <span class="text-[#111111] font-medium">AERO 04</span>
        </nav>
      </div>

      <!-- Интерактивный поиск по каталогу -->
      <div class="relative flex-1 max-w-xs hidden md:block">
        <div class="relative flex items-center">
          <svg class="w-3.5 h-3.5 text-neutral-400 absolute left-3.5 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
          </svg>
          <input
            type="text"
            id="catalogSearchInput"
            placeholder="Поиск по коллекции (пуф, торшер, дуб)..."
            autocomplete="off"
            class="w-full pl-9 pr-3 py-1.5 rounded-full bg-white border border-[#E5E5E5] focus:border-[#111111] focus:outline-none text-xs text-[#111111] placeholder:text-neutral-400 transition-colors"
          />
        </div>
        <!-- Выпадающий список результатов -->
        <div id="searchDropdown" class="hidden absolute left-0 right-0 mt-2 bg-white border border-[#E5E5E5] rounded-xl shadow-lg overflow-hidden z-50"></div>
      </div>

      <!-- Правые действия -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a href="#detailsTabsSection" class="hidden lg:inline-block px-2.5 py-1.5 text-xs text-neutral-500 hover:text-[#111111] transition-colors">
          Чертеж 1:1
        </a>
        <a href="#companionSection" class="hidden lg:inline-block px-2.5 py-1.5 text-xs text-neutral-500 hover:text-[#111111] transition-colors">
          Комплект
        </a>

        <!-- Избранное со счетчиком -->
        <button
          type="button"
          id="headerWishBtn"
          aria-label="Избранное"
          class="relative flex items-center gap-1.5 px-3 py-2 rounded-full bg-white border border-[#E5E5E5] hover:border-[#111111] transition-colors"
        >
          <svg id="headerWishSvg" class="w-4 h-4 text-[#111111] transition-colors" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
          <span id="headerWishCount" class="hidden px-1.5 py-0.2 rounded-full bg-[#DC2626] text-white font-mono text-[10px] font-medium tabular">1</span>
        </button>

        <!-- Корзина -->
        <button
          type="button"
          id="openCartBtn"
          class="flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-full bg-white border border-[#E5E5E5] hover:border-[#111111] text-xs font-medium transition-colors"
        >
          <span>Корзина</span>
          <span id="cartBadge" class="w-5 h-5 rounded-full bg-[#111111] text-white font-mono text-[11px] flex items-center justify-center tabular">1</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== 2. ФИКСИРОВАННАЯ КНОПКА-ТРИГГЕР ПАНЕЛИ НАСТРОЕК ==================== -->
  <button
    type="button"
    id="openCustomizerBtn"
    aria-label="Открыть панель настроек интерфейса"
    class="fixed right-0 top-1/2 -translate-y-1/2 z-40 flex items-center gap-2.5 pl-3.5 pr-3 py-3 bg-[#111111] hover:bg-neutral-800 text-white rounded-l-xl shadow-lg border border-r-0 border-white/15 transition-all duration-300 group"
  >
    <svg class="w-4 h-4 text-white group-hover:rotate-45 transition-transform duration-300 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
    </svg>
    <span class="hidden sm:inline font-mono text-xs font-medium tracking-wide">Настройки</span>
    <span id="customizerChangedBadge" class="hidden w-4 h-4 rounded-full bg-[#16A34A] text-white font-mono text-[10px] font-bold flex items-center justify-center tabular">0</span>
  </button>

  <!-- ==================== 3. ОСНОВНОЙ КОНТЕНТ КАРТОЧКИ ТОВАРА ==================== -->
  <main class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 pt-6 sm:pt-10 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

      <!-- ЛЕВАЯ КОЛОНКА (7 колонок): ДИНАМИЧЕСКАЯ ГАЛЕРЕЯ (3 РЕЖИМА ИЗ НАСТРОЕК) -->
      <div class="lg:col-span-7 space-y-5">

        <!-- Верхняя панель фильтров ракурсов и подсказки -->
        <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-[#E5E5E5]">
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar" id="galleryFilterGroup">
            <button type="button" data-view="all" class="view-filter-btn px-3.5 py-1.5 rounded-full bg-[#111111] text-white text-xs font-medium whitespace-nowrap transition-colors">
              Все фото (05)
            </button>
            <button type="button" data-view="studio" class="view-filter-btn px-3.5 py-1.5 rounded-full bg-transparent text-neutral-500 hover:text-[#111111] text-xs font-medium whitespace-nowrap transition-colors">
              Студия
            </button>
            <button type="button" data-view="detail" class="view-filter-btn px-3.5 py-1.5 rounded-full bg-transparent text-neutral-500 hover:text-[#111111] text-xs font-medium whitespace-nowrap transition-colors">
              Детали и фактура
            </button>
            <button type="button" data-view="interior" class="view-filter-btn px-3.5 py-1.5 rounded-full bg-transparent text-neutral-500 hover:text-[#111111] text-xs font-medium whitespace-nowrap transition-colors">
              В интерьере
            </button>
          </div>
          <span class="hidden sm:inline font-mono text-[11px] text-neutral-400">НАЖМИТЕ НА ФОТО ДЛЯ ЗУМА</span>
        </div>

        <!-- РЕЖИМ A: СЕТКА С ВЕРТИКАЛЬНЫМ СКРОЛЛОМ (ПО УМОЛЧАНИЮ) -->
        <div id="galleryLayoutGrid" class="space-y-5 sm:space-y-6">
          <!-- Главный кадр -->
          <figure data-category="studio" data-index="0" class="gallery-card reveal-card gallery-frame ui-card relative bg-white overflow-hidden cursor-zoom-in group">
            <div class="relative aspect-[16/12] overflow-hidden bg-[#F5F5F4]">
              <img
                id="primaryChairImage"
                src="{{ thumb ?: 'https://images.unsplash.com/photo-1567538096630-e0c55bd6374c?auto=format&fit=crop&w=1400&q=85' }}"
                alt="NORDIC FORM AERO 04 — Фронтальный ракурс"
                onerror="this.onerror=null;this.src='https://placehold.co/1200x900/F5F5F4/111111?text=NORDIC+FORM+AERO+04';"
                class="gallery-img w-full h-full object-cover"
              />
              <!-- Живой бейдж выбранного материала на фото -->
              <div class="absolute top-4 left-4 flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur-sm border border-[#E5E5E5] text-xs">
                <span id="photoSwatchDot" class="w-2.5 h-2.5 rounded-full bg-[#F3EFEA] border border-neutral-400"></span>
                <span id="photoFabricLabel" class="font-medium text-[#111111]">Буклее Айвори</span>
              </div>
            </div>
            <figcaption class="px-5 py-3.5 bg-white border-t border-[#E5E5E5] flex items-center justify-between text-xs text-neutral-500">
              <span>01 / Архитектурный силуэт и эргономичный наклон спинки 104°</span>
              <span class="font-mono text-[#111111] group-hover:translate-x-0.5 transition-transform">↗</span>
            </figcaption>
          </figure>

          <!-- Пара деталей -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
            <figure data-category="detail" data-index="1" class="gallery-card reveal-card gallery-frame ui-card relative bg-white overflow-hidden cursor-zoom-in group">
              <div class="aspect-square overflow-hidden bg-[#F5F5F4]">
                <img
                  src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=900&q=85"
                  alt="Фактура обивки"
                  onerror="this.onerror=null;this.src='https://placehold.co/800x800/F5F5F4/111111?text=FABRIC+TEXTURE';"
                  class="gallery-img w-full h-full object-cover"
                />
              </div>
              <figcaption class="px-4 py-3 bg-white border-t border-[#E5E5E5] flex items-center justify-between text-xs text-neutral-500">
                <span>02 / Тактильное плетение и плотность</span>
                <span class="font-mono text-[#111111]">↗</span>
              </figcaption>
            </figure>

            <figure data-category="interior" data-index="2" class="gallery-card reveal-card gallery-frame ui-card relative bg-white overflow-hidden cursor-zoom-in group">
              <div class="aspect-square overflow-hidden bg-[#F5F5F4]">
                <img
                  src="https://images.unsplash.com/photo-1598300042247-d088f8ab3a91?auto=format&fit=crop&w=900&q=85"
                  alt="В светлой гостиной"
                  onerror="this.onerror=null;this.src='https://placehold.co/800x800/F5F5F4/111111?text=LIVING+ROOM';"
                  class="gallery-img w-full h-full object-cover"
                />
              </div>
              <figcaption class="px-4 py-3 bg-white border-t border-[#E5E5E5] flex items-center justify-between text-xs text-neutral-500">
                <span>03 / Интеграция в светлый интерьер</span>
                <span class="font-mono text-[#111111]">↗</span>
              </figcaption>
            </figure>
          </div>

          <!-- Атмосферный широкий кадр -->
          <figure data-category="interior" data-index="3" class="gallery-card reveal-card gallery-frame ui-card relative bg-white overflow-hidden cursor-zoom-in group">
            <div class="aspect-[16/10] overflow-hidden bg-[#F5F5F4]">
              <img
                src="https://images.unsplash.com/photo-1618220179428-22790b461013?auto=format&fit=crop&w=1400&q=85"
                alt="Пространство Japandi"
                onerror="this.onerror=null;this.src='https://placehold.co/1200x750/F5F5F4/111111?text=JAPANDI+INTERIOR';"
                class="gallery-img w-full h-full object-cover"
              />
            </div>
            <figcaption class="px-5 py-3.5 bg-white border-t border-[#E5E5E5] flex items-center justify-between text-xs text-neutral-500">
              <span>04 / Баланс натурального дерева и мягкой геометрии</span>
              <span class="font-mono text-[#111111]">↗</span>
            </figcaption>
          </figure>

          <!-- Деталь каркаса -->
          <figure data-category="detail" data-index="4" class="gallery-card reveal-card gallery-frame ui-card relative bg-white overflow-hidden cursor-zoom-in group">
            <div class="aspect-[16/9] overflow-hidden bg-[#F5F5F4]">
              <img
                src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=1400&q=85"
                alt="Эргономика посадки"
                onerror="this.onerror=null;this.src='https://placehold.co/1200x675/F5F5F4/111111?text=ERGONOMICS';"
                class="gallery-img w-full h-full object-cover"
              />
            </div>
            <figcaption class="px-5 py-3.5 bg-white border-t border-[#E5E5E5] flex items-center justify-between text-xs text-neutral-500">
              <span>05 / Многослойный наполнитель с эффектом памяти формы</span>
              <span class="font-mono text-[#111111]">↗</span>
            </figcaption>
          </figure>
        </div>

        <!-- РЕЖИМ B / C: СЛАЙДЕР С МИНИАТЮРАМИ (СЛЕВА ИЛИ СНИЗУ — УПРАВЛЯЕТСЯ ПАНЕЛЬЮ НАСТРОЕК) -->
        <div id="galleryLayoutSlider" class="hidden gap-4">
          <!-- Контейнер миниатюр -->
          <div id="sliderThumbsContainer" class="flex gap-2.5 shrink-0"></div>

          <!-- Основной слайд -->
          <div class="flex-1 ui-card bg-white overflow-hidden relative group">
            <div class="relative aspect-[4/3] bg-[#F5F5F4] overflow-hidden cursor-zoom-in" id="sliderMainStage">
              <img id="sliderActiveImg" src="https://images.unsplash.com/photo-1567538096630-e0c55bd6374c?auto=format&fit=crop&w=1400&q=85" alt="Слайд товара" class="w-full h-full object-cover transition-all duration-500" />
              <button type="button" id="sliderPrevBtn" aria-label="Предыдущее фото" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 border border-[#E5E5E5] hover:border-[#111111] flex items-center justify-center text-sm shadow-sm transition-colors">←</button>
              <button type="button" id="sliderNextBtn" aria-label="Следующее фото" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 border border-[#E5E5E5] hover:border-[#111111] flex items-center justify-center text-sm shadow-sm transition-colors">→</button>
            </div>
            <div class="px-5 py-3.5 bg-white border-t border-[#E5E5E5] flex items-center justify-between text-xs text-neutral-500">
              <span id="sliderCaption">01 / Архитектурный силуэт и эргономичный наклон спинки 104°</span>
              <span id="sliderCounter" class="font-mono text-[#111111]">1 / 5</span>
            </div>
          </div>
        </div>

        <!-- ИНТЕРАКТИВНЫЙ БЛОК ПОД ГАЛЕРЕЕЙ (ВКЛАДКИ) -->
        <section id="detailsTabsSection" class="pt-6">
          <div class="ui-card bg-white overflow-hidden">
            <!-- Навигация по вкладкам -->
            <div class="flex items-center border-b border-[#E5E5E5] overflow-x-auto no-scrollbar">
              <button type="button" data-tab="concept" class="detail-tab-btn px-5 py-4 text-xs font-medium border-b-2 border-[#111111] text-[#111111] whitespace-nowrap transition-colors">
                Описание и концепция
              </button>
              <button type="button" data-tab="specs" class="detail-tab-btn px-5 py-4 text-xs font-medium border-b-2 border-transparent text-neutral-500 hover:text-[#111111] whitespace-nowrap transition-colors">
                Характеристики
              </button>
              <button type="button" data-tab="blueprint" class="detail-tab-btn px-5 py-4 text-xs font-medium border-b-2 border-transparent text-neutral-500 hover:text-[#111111] whitespace-nowrap transition-colors">
                Чертеж 1:1
              </button>
              <button type="button" data-tab="reviews" class="detail-tab-btn px-5 py-4 text-xs font-medium border-b-2 border-transparent text-neutral-500 hover:text-[#111111] whitespace-nowrap transition-colors flex items-center gap-1.5">
                <span>Отзывы</span>
                <span id="tabReviewsCounter" class="px-1.5 py-0.5 rounded-full bg-[#FAFAFA] border border-[#E5E5E5] font-mono text-[10px] text-[#111111]">24</span>
              </button>
              <button type="button" data-tab="delivery" class="detail-tab-btn px-5 py-4 text-xs font-medium border-b-2 border-transparent text-neutral-500 hover:text-[#111111] whitespace-nowrap transition-colors">
                Доставка и возврат
              </button>
            </div>

            <!-- Контент вкладок -->
            <div class="p-6 sm:p-8">
              
