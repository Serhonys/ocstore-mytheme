{{ header }}
<main class="layout" id="information-contact">
  {{ column_left }}
  <div id="content" class="layout-main">
    <ul class="crumbs">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    {{ content_top }}
    <h1>{{ heading_title }}</h1>
    <h2>{{ text_location }}</h2>
    <div class="split">
      {% if image %}<img src="{{ image }}" alt="{{ store }}" />{% endif %}
      <div>
        <strong>{{ store }}</strong>
        <address>{{ address }}</address>
        {% if geocode %}<a class="btn btn-ghost" href="https://maps.google.com/maps?q={{ geocode|url_encode }}&hl={{ geocode_hl }}&t=m&z=15" target="_blank" rel="noopener">{{ button_map }}</a>{% endif %}
        <p><strong>{{ text_telephone }}</strong><br>{{ telephone }}</p>
        {% if fax %}<p><strong>{{ text_fax }}</strong><br>{{ fax }}</p>{% endif %}
        {% if open %}<p><strong>{{ text_open }}</strong><br>{{ open }}</p>{% endif %}
        {% if comment %}<p>{{ comment }}</p>{% endif %}
      </div>
    </div>
    {% if locations %}
    <h2>{{ text_store }}</h2>
    {% for location in locations %}
    <section class="side-block">
      <h3>{{ location.name }}</h3>
      <address>{{ location.address }}</address>
      <p>{{ location.telephone }}</p>
      {% if location.open %}<p>{{ location.open }}</p>{% endif %}
    </section>
    {% endfor %}
    {% endif %}
    <form action="{{ action }}" method="post" enctype="multipart/form-data">
      <h2>{{ text_contact }}</h2>
      <div class="field">
        <label for="input-name">{{ entry_name }}</label>
        <input type="text" name="name" value="{{ name }}" id="input-name" />
        {% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}
      </div>
      <div class="field">
        <label for="input-email">{{ entry_email }}</label>
        <input type="text" name="email" value="{{ email }}" id="input-email" />
        {% if error_email %}<div class="text-danger">{{ error_email }}</div>{% endif %}
      </div>
      <div class="field">
        <label for="input-enquiry">{{ entry_enquiry }}</label>
        <textarea name="enquiry" rows="8" id="input-enquiry">{{ enquiry }}</textarea>
        {% if error_enquiry %}<div class="text-danger">{{ error_enquiry }}</div>{% endif %}
      </div>
      {{ captcha }}
      <input class="btn" type="submit" value="{{ button_submit }}" />
    </form>
    {{ content_bottom }}
  </div>
  {{ column_right }}
</main>
{{ footer }}
