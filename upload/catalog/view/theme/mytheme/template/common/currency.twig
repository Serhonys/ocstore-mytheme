{% if currencies|length > 1 %}
<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-currency" class="switchers">
  {% for currency in currencies %}
  <button class="currency-select{% if currency.code == code %} is-current{% endif %}" type="button" name="{{ currency.code }}">{{ currency.symbol_left }}{{ currency.symbol_right }} {{ currency.title }}</button>
  {% endfor %}
  <input type="hidden" name="code" value="" />
  <input type="hidden" name="redirect" value="{{ redirect }}" />
</form>
{% endif %}
