{{ header }}
<main class="layout" id="product-product">
  {{ column_left }}
  <div id="content" class="layout-main">
    <ul class="crumbs breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    {{ content_top }}
    <div class="nf-product">
      <div>
        {% if thumb or images %}
        <ul class="thumbnails">
          {% if thumb %}
          <li><a href="{{ popup }}" title="{{ heading_title }}"><img src="{{ thumb }}" alt="{{ heading_title }}" /></a></li>
          {% endif %}
          {% if images %}
          {% for image in images %}
          <li class="image-additional"><a href="{{ image.popup }}" title="{{ heading_title }}"><img src="{{ image.thumb }}" alt="{{ heading_title }}" /></a></li>
          {% endfor %}
          {% endif %}
        </ul>
        {% endif %}
        <div class="tabs">
          <ul class="tab-nav">
            <li class="is-active"><a href="#tab-description">{{ tab_description }}</a></li>
            {% if attribute_groups %}<li><a href="#tab-specification">{{ tab_attribute }}</a></li>{% endif %}
            {% if review_status %}<li><a href="#tab-review">{{ tab_review }}</a></li>{% endif %}
          </ul>
          <div class="tab-pane is-active" id="tab-description">{{ description }}</div>
          {% if attribute_groups %}
          <div class="tab-pane" id="tab-specification">
            <table class="table">
              {% for attribute_group in attribute_groups %}
              <tr><td colspan="2"><strong>{{ attribute_group.name }}</strong></td></tr>
              {% for attribute in attribute_group.attribute %}
              <tr><td>{{ attribute.name }}</td><td>{{ attribute.text }}</td></tr>
              {% endfor %}
              {% endfor %}
            </table>
          </div>
          {% endif %}
          {% if review_status %}
          <div class="tab-pane" id="tab-review">
            <form id="form-review">
              <div id="review"></div>
              <h2>{{ text_write }}</h2>
              {% if review_guest %}
              <div class="field"><label for="input-name">{{ entry_name }}</label><input type="text" name="name" value="{{ customer_name }}" id="input-name" /></div>
              <div class="field"><label for="input-review">{{ entry_review }}</label><textarea name="text" rows="5" id="input-review"></textarea><p>{{ text_note }}</p></div>
              <div class="field">
                {{ entry_rating }} {{ entry_bad }}
                <input type="radio" name="rating" value="1" />
                <input type="radio" name="rating" value="2" />
                <input type="radio" name="rating" value="3" />
                <input type="radio" name="rating" value="4" />
                <input type="radio" name="rating" value="5" />
                {{ entry_good }}
              </div>
              {{ captcha }}
              <button type="button" id="button-review" data-loading-text="{{ text_loading }}" class="btn">{{ button_continue }}</button>
              {% else %}{{ text_login }}{% endif %}
            </form>
          </div>
          {% endif %}
        </div>
      </div>
      <aside class="nf-buy">
        <div class="sku">
          <span class="mono">{{ text_model }} {{ model }}</span>
          <span class="stock-ok">{{ text_stock }} {{ stock }}</span>
        </div>
        <h1>{{ heading_title }}</h1>
        <ul class="meta">
          {% if manufacturer %}<li>{{ text_manufacturer }} <a href="{{ manufacturers }}">{{ manufacturer }}</a></li>{% endif %}
          {% if reward %}<li>{{ text_reward }} {{ reward }}</li>{% endif %}
        </ul>
        {% if price %}
        <div class="price-lg">
          {% if not special %}{{ price }}{% else %}<span class="price-old">{{ price }}</span> {{ special }}{% endif %}
        </div>
        {% if tax %}<p class="meta">{{ text_tax }} {{ tax }}</p>{% endif %}
        {% if points %}<p class="meta">{{ text_points }} {{ points }}</p>{% endif %}
        {% if discounts %}
        <ul class="meta">{% for discount in discounts %}<li>{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</li>{% endfor %}</ul>
        {% endif %}
        {% endif %}
        <div id="product">
          {% if options %}
          <h2 style="font-size:14px;">{{ text_option }}</h2>
          {% for option in options %}
          {% if option.type == 'select' %}
          <div class="field{% if option.required %} required{% endif %}">
            <label for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}">
              <option value="">{{ text_select }}</option>
              {% for option_value in option.product_option_value %}
              <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}{% if option_value.price %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}</option>
              {% endfor %}
            </select>
          </div>
          {% endif %}
          {% if option.type == 'radio' %}
          <div class="field{% if option.required %} required{% endif %}">
            <label>{{ option.name }}</label>
            <div id="input-option{{ option.product_option_id }}">
              {% for option_value in option.product_option_value %}
              <label class="nf-choice">
                <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" />
                {% if option_value.image %}<img src="{{ option_value.image }}" alt="" style="width:28px;height:28px;object-fit:cover;border-radius:999px;" />{% endif %}
                <span>{{ option_value.name }}{% if option_value.price %} <span class="mono">{{ option_value.price_prefix }}{{ option_value.price }}</span>{% endif %}</span>
              </label>
              {% endfor %}
            </div>
          </div>
          {% endif %}
          {% if option.type == 'checkbox' %}
          <div class="field{% if option.required %} required{% endif %}">
            <label>{{ option.name }}</label>
            <div id="input-option{{ option.product_option_id }}">
              {% for option_value in option.product_option_value %}
              <label class="nf-choice">
                <input type="checkbox" name="option[{{ option.product_option_id }}][]" value="{{ option_value.product_option_value_id }}" />
                <span>{{ option_value.name }}{% if option_value.price %} <span class="mono">{{ option_value.price_prefix }}{{ option_value.price }}</span>{% endif %}</span>
              </label>
              {% endfor %}
            </div>
          </div>
          {% endif %}
          {% if option.type == 'text' %}
          <div class="field{% if option.required %} required{% endif %}">
            <label for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" id="input-option{{ option.product_option_id }}" />
          </div>
          {% endif %}
          {% if option.type == 'textarea' %}
          <div class="field{% if option.required %} required{% endif %}">
            <label for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <textarea name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" rows="4">{{ option.value }}</textarea>
          </div>
          {% endif %}
          {% if option.type == 'file' %}
          <div class="field{% if option.required %} required{% endif %}">
            <label>{{ option.name }}</label>
            <button type="button" id="button-upload{{ option.product_option_id }}" data-loading-text="{{ text_loading }}" class="btn btn-ghost">{{ button_upload }}</button>
            <input type="hidden" name="option[{{ option.product_option_id }}]" value="" id="input-option{{ option.product_option_id }}" />
          </div>
          {% endif %}
          {% if option.type == 'date' %}
          <div class="field{% if option.required %} required{% endif %}">
            <label for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <div class="date"><input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD" id="input-option{{ option.product_option_id }}" /></div>
          </div>
          {% endif %}
          {% if option.type == 'datetime' %}
          <div class="field{% if option.required %} required{% endif %}">
            <label for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <div class="datetime"><input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD HH:mm" id="input-option{{ option.product_option_id }}" /></div>
          </div>
          {% endif %}
          {% if option.type == 'time' %}
          <div class="field{% if option.required %} required{% endif %}">
            <label for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
            <div class="time"><input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="HH:mm" id="input-option{{ option.product_option_id }}" /></div>
          </div>
          {% endif %}
          {% endfor %}
          {% endif %}
          {% if recurrings %}
          <div class="field required">
            <label>{{ text_payment_recurring }}</label>
            <select name="recurring_id">
              <option value="">{{ text_select }}</option>
              {% for recurring in recurrings %}<option value="{{ recurring.recurring_id }}">{{ recurring.name }}</option>{% endfor %}
            </select>
            <div id="recurring-description"></div>
          </div>
          {% endif %}
          <div class="field">
            <label for="input-quantity">{{ entry_qty }}</label>
            <div class="qty-row">
              <input type="text" name="quantity" value="{{ minimum }}" id="input-quantity" />
              <input type="hidden" name="product_id" value="{{ product_id }}" />
            </div>
          </div>
          <button type="button" id="button-cart" data-loading-text="{{ text_loading }}" class="btn">{{ button_cart }}</button>
          <p class="actions">
            <button type="button" class="btn btn-ghost" onclick="wishlist.add('{{ product_id }}');">{{ button_wishlist }}</button>
            <button type="button" class="btn btn-ghost" onclick="compare.add('{{ product_id }}');">{{ button_compare }}</button>
          </p>
          {% if minimum > 1 %}<div class="alert alert-info">{{ text_minimum }}</div>{% endif %}
          {% if review_status %}<p class="meta"><a href="#tab-review">{{ reviews }}</a> · <a href="#tab-review">{{ text_write }}</a></p>{% endif %}
        </div>
      </aside>
    </div>
    {% if products %}
    <h2>{{ text_related }}</h2>
    <div class="grid">
      {% for product in products %}
      <article class="card">
        <a class="card-media" href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" /></a>
        <div class="card-body">
          <h3><a href="{{ product.href }}">{{ product.name }}</a></h3>
          {% if product.price %}<p class="card-price">{% if not product.special %}{{ product.price }}{% else %}<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>{% endif %}</p>{% endif %}
          <button type="button" class="btn" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">{{ button_cart }}</button>
        </div>
      </article>
      {% endfor %}
    </div>
    {% endif %}
    {% if tags %}
    <p>{{ text_tags }}
      {% for i in 0..tags|length - 1 %}
      {% if i < (tags|length - 1) %}<a href="{{ tags[i].href }}">{{ tags[i].tag }}</a>, {% else %}<a href="{{ tags[i].href }}">{{ tags[i].tag }}</a>{% endif %}
      {% endfor %}
    </p>
    {% endif %}
    {{ content_bottom }}
  </div>
  {{ column_right }}
</main>
<script>
$('select[name=\'recurring_id\'], input[name="quantity"]').change(function(){
  $.ajax({
    url: 'index.php?route=product/product/getRecurringDescription',
    type: 'post',
    data: $('input[name=\'product_id\'], input[name=\'quantity\'], select[name=\'recurring_id\']'),
    dataType: 'json',
    success: function(json) { if (json['success']) { $('#recurring-description').html(json['success']); } }
  });
});
$('#button-cart').on('click', function() {
  $.ajax({
    url: 'index.php?route=checkout/cart/add',
    type: 'post',
    data: $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea'),
    dataType: 'json',
    beforeSend: function() { $('#button-cart').button('loading'); },
    complete: function() { $('#button-cart').button('reset'); },
    success: function(json) {
      $('.alert-dismissible, .text-danger').remove();
      if (json['error']) {
        if (json['error']['option']) {
          for (i in json['error']['option']) {
            $('#input-option' + i.replace('_', '-')).after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
          }
        }
        if (json['error']['recurring']) {
          $('select[name=\'recurring_id\']').after('<div class="text-danger">' + json['error']['recurring'] + '</div>');
        }
      }
      if (json['success']) {
        $('.breadcrumb').after('<div class="alert alert-success alert-dismissible">' + json['success'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        $('#cart > button').html('<span class="badge" id="cart-total">' + json['total'] + '</span>');
        $('html, body').animate({ scrollTop: 0 }, 'slow');
        $('#cart > ul').load('index.php?route=common/cart/info ul li');
      }
    }
  });
});
$(document).on('click', 'a[href="#tab-review"]', function (e) {
  e.preventDefault();
  $('.tab-nav a[href="#tab-review"]').trigger('click');
});
$('.date, .datetime, .time').each(function () {
  if (!$.fn.datetimepicker) return;
  $(this).datetimepicker({
    language: '{{ datepicker }}',
    pickTime: $(this).hasClass('time') || $(this).hasClass('datetime'),
    pickDate: !$(this).hasClass('time')
  });
});
$('button[id^=\'button-upload\']').on('click', function() {
  var node = this;
  $('#form-upload').remove();
  $('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display:none;"><input type="file" name="file" /></form>');
  $('#form-upload input[name=\'file\']').trigger('click');
  if (typeof timer != 'undefined') { clearInterval(timer); }
  timer = setInterval(function() {
    if ($('#form-upload input[name=\'file\']').val() != '') {
      clearInterval(timer);
      $.ajax({
        url: 'index.php?route=tool/upload',
        type: 'post',
        dataType: 'json',
        data: new FormData($('#form-upload')[0]),
        cache: false,
        contentType: false,
        processData: false,
        success: function(json) {
          if (json['error']) { $(node).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>'); }
          if (json['success']) { $(node).parent().find('input').val(json['code']); }
        }
      });
    }
  }, 500);
});
$('#review').load('index.php?route=product/product/review&product_id={{ product_id }}');
$('#review').on('click', '.pagination a', function(e) { e.preventDefault(); $('#review').load(this.href); });
$('#button-review').on('click', function() {
  $.ajax({
    url: 'index.php?route=product/product/write&product_id={{ product_id }}',
    type: 'post',
    dataType: 'json',
    data: $('#form-review').serialize(),
    beforeSend: function() { $('#button-review').button('loading'); },
    complete: function() { $('#button-review').button('reset'); },
    success: function(json) {
      $('.alert-dismissible').remove();
      if (json['error']) { $('#review').after('<div class="alert alert-danger alert-dismissible">' + json['error'] + '</div>'); }
      if (json['success']) {
        $('#review').after('<div class="alert alert-success alert-dismissible">' + json['success'] + '</div>');
        $('input[name=\'name\'], textarea[name=\'text\']').val('');
        $('input[name=\'rating\']:checked').prop('checked', false);
      }
    }
  });
});
$(function () {
  if ($.fn.magnificPopup) {
    $('.thumbnails').magnificPopup({ type:'image', delegate: 'a', gallery: { enabled: true } });
  }
});
</script>
{{ footer }}
