{{ header }}
<main class="layout" id="product-category">
  {{ column_left }}
  <div id="content" class="layout-main">
    <ul class="crumbs">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    {{ content_top }}
    <h1>{{ heading_title }}</h1>
    {% if thumb or description %}
    <div class="split">
      {% if thumb %}<img src="{{ thumb }}" alt="{{ heading_title }}" />{% endif %}
      {% if description %}<div>{{ description }}</div>{% endif %}
    </div>
    {% endif %}
    {% if categories %}
    <h2>{{ text_refine }}</h2>
    <div class="refine">
      {% for category in categories %}
      <a href="{{ category.href }}">{{ category.name }}</a>
      {% endfor %}
    </div>
    {% endif %}
    {% if products %}
    <div class="toolbar">
      <a href="{{ compare }}" id="compare-total">{{ text_compare }}</a>
      <label>{{ text_sort }}
        <select id="input-sort" onchange="location = this.value;">
          {% for sorts in sorts %}
          <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected="selected"{% endif %}>{{ sorts.text }}</option>
          {% endfor %}
        </select>
      </label>
      <label>{{ text_limit }}
        <select id="input-limit" onchange="location = this.value;">
          {% for limits in limits %}
          <option value="{{ limits.href }}"{% if limits.value == limit %} selected="selected"{% endif %}>{{ limits.text }}</option>
          {% endfor %}
        </select>
      </label>
    </div>
    <div class="grid">
      {% for product in products %}
      <article class="card">
        <a class="card-media" href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" /></a>
        <div class="card-body">
          <h3><a href="{{ product.href }}">{{ product.name }}</a></h3>
          {% if product.description %}<p>{{ product.description }}</p>{% endif %}
          {% if product.price %}
          <p class="card-price">
            {% if not product.special %}{{ product.price }}{% else %}<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>{% endif %}
            {% if product.tax %}<span class="price-tax">{{ text_tax }} {{ product.tax }}</span>{% endif %}
          </p>
          {% endif %}
          {% if product.rating %}
          <div class="stars">{% for i in 1..5 %}<span class="{% if product.rating < i %}is-off{% endif %}">★</span>{% endfor %}</div>
          {% endif %}
          <button type="button" class="btn" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">{{ button_cart }}</button>
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="toolbar">
      <div>{{ pagination }}</div>
      <div>{{ results }}</div>
    </div>
    {% endif %}
    {% if not categories and not products %}
    <p class="empty">{{ text_empty }}</p>
    <a class="btn" href="{{ continue }}">{{ button_continue }}</a>
    {% endif %}
    {{ content_bottom }}
  </div>
  {{ column_right }}
</main>
{{ footer }}
