<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<base href="{{ base }}" />
{% if description %}<meta name="description" content="{{ description }}" />{% endif %}
{% if keywords %}<meta name="keywords" content="{{ keywords }}" />{% endif %}
{% set body_font = font_body|default('Inter') %}
{% set head_font = font_heading|default('Plus Jakarta Sans') %}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family={{ body_font|replace({' ': '+'}) }}:wght@300;400;500;600;700&family={{ head_font|replace({' ': '+'}) }}:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<script src="catalog/view/javascript/jquery/jquery-2.1.1.min.js"></script>
<script src="catalog/view/javascript/bootstrap/js/bootstrap.min.js"></script>
<link href="catalog/view/theme/mytheme/stylesheet/stylesheet.css" rel="stylesheet" />
{% set ui_radius = radius|default(14) %}
<style>
:root {
  --c-bg: {{ color_bg|default('#FAFAFA') }};
  --c-text: {{ color_text|default('#111111') }};
  --c-primary: {{ color_primary|default('#111111') }};
  --c-card: {{ color_card|default('#FFFFFF') }};
  --c-line: {{ color_line|default('#E5E5E5') }};
  --c-sale: {{ color_sale|default('#DC2626') }};
  --c-ok: {{ color_ok|default('#16A34A') }};
  --radius: {{ ui_radius }}px;
  --radius-sm: {{ ui_radius - 4 }}px;
  --font-body: "{{ body_font }}", system-ui, sans-serif;
  --font-heading: "{{ head_font }}", Inter, sans-serif;
}
</style>
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}"></script>
{% endfor %}
<script src="catalog/view/javascript/common.js"></script>
<script src="catalog/view/theme/mytheme/javascript/theme.js"></script>
{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}" />
{% endfor %}
{% for analytic in analytics %}
{{ analytic }}
{% endfor %}
</head>
<body>
<header class="site-header">
  <div class="shell site-header-row">
    <a class="brand" href="{{ home }}">{% if logo %}<img src="{{ logo }}" alt="{{ name }}" style="max-height:28px;width:auto;" />{% else %}{{ name }}{% endif %}</a>
    <div class="header-tools">
      <div class="top-meta">
        {{ language }}
        {{ currency }}
        {% if telephone %}<a href="tel:{{ telephone|replace({' ': '', '(': '', ')': '', '-': ''}) }}">{{ telephone }}</a>{% endif %}
        <div class="account">
          <button type="button" id="account-toggle">{{ text_account }}</button>
          <div class="account-menu">
            {% if logged %}
            <a href="{{ account }}">{{ text_account }}</a>
            <a href="{{ order }}">{{ text_order }}</a>
            <a href="{{ transaction }}">{{ text_transaction }}</a>
            <a href="{{ download }}">{{ text_download }}</a>
            <a href="{{ logout }}">{{ text_logout }}</a>
            {% else %}
            <a href="{{ register }}">{{ text_register }}</a>
            <a href="{{ login }}">{{ text_login }}</a>
            {% endif %}
            <a href="{{ shopping_cart }}">{{ text_shopping_cart }}</a>
            <a href="{{ checkout }}">{{ text_checkout }}</a>
          </div>
        </div>
      </div>
      {{ search }}
      <a class="pill" href="{{ wishlist }}" id="wishlist-total" aria-label="{{ text_wishlist }}">{{ text_wishlist }}</a>
      {{ cart }}
    </div>
  </div>
  {% if tagline %}<div class="shell tagline">{{ tagline }}</div>{% endif %}
</header>
{{ menu }}
