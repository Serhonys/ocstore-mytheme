  <!-- ==================== 10. УВЕДОМЛЕНИЯ (TOASTS) ==================== -->
  <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- ==================== JAVASCRIPT ЛОГИКА ==================== -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const BASE_PRICE = 89000;
      const BASE_OLD_PRICE = 108500;

      const galleryData = [
        {
          src: 'https://images.unsplash.com/photo-1567538096630-e0c55bd6374c?auto=format&fit=crop&w=1400&q=85',
          caption: '01 / Архитектурный силуэт и эргономичный наклон спинки 104°'
        },
        {
          src: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=1400&q=85',
          caption: '02 / Тактильное плетение и плотность'
        },
        {
          src: 'https://images.unsplash.com/photo-1598300042247-d088f8ab3a91?auto=format&fit=crop&w=1400&q=85',
          caption: '03 / Интеграция в светлый интерьер'
        },
        {
          src: 'https://images.unsplash.com/photo-1618220179428-22790b461013?auto=format&fit=crop&w=1400&q=85',
          caption: '04 / Баланс натурального дерева и мягкой геометрии'
        },
        {
          src: 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=1400&q=85',
          caption: '05 / Многослойный наполнитель с эффектом памяти формы'
        }
      ];

      const state = {
        fabric: 'Буклее Айвори',
        fabricCategory: 'Текстиль Буклее (85 000 циклов)',
        fabricDelta: 0,
        fabricFilter: 'none',
        frame: 'Беленый дуб',
        frameDelta: 0,
        size: 'Standard',
        dims: { w: 78, d: 84, h: 76 },
        sizeDelta: 0,
        options: [],
        qty: 1,
        wishlisted: false,
        promoCode: null,
        promoPercent: 0,
        bpUnit: 'cm',
        activeSlide: 0,
        lightboxIndex: 0,
        cart: [
          {
            id: 'aero04-Буклее Айвори-Беленый дуб-Standard-',
            name: 'NORDIC FORM — AERO 04',
            meta: 'Буклее Айвори · Беленый дуб · Standard',
            price: 89000,
            qty: 1
          }
        ],
        ui: {
          galleryMode: 'grid',
          radius: '14',
          borderStyle: 'hairline',
          accent: '#111111',
          density: 'expanded',
          toggles: {
            discount: true,
            urgency: true,
            shipping: true,
            oneclick: true,
            installment: true,
            blueprint: true
          }
        }
      };

      const formatRUB = (n) => n.toLocaleString('ru-RU') + ' ₽';

      // Уведомления
      const showToast = (msg, type = 'green') => {
        const el = document.createElement('div');
        const dot = type === 'red' ? 'bg-[#DC2626]' : 'bg-[#16A34A]';
        el.className = 'pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl bg-[#111111] text-white text-xs shadow-lg transform translate-y-3 opacity-0 transition-all duration-300';
        el.innerHTML = `<span class="w-2 h-2 rounded-full ${dot} shrink-0"></span><span>${msg}</span>`;
        document.getElementById('toastContainer').appendChild(el);
        requestAnimationFrame(() => el.classList.remove('translate-y-3', 'opacity-0'));
        setTimeout(() => {
          el.classList.add('translate-y-3', 'opacity-0');
          setTimeout(() => el.remove(), 300);
        }, 2500);
      };

      // Расчет текущей цены конфигурации
      const getUnitPrice = () => {
        const optsSum = state.options.reduce((s, o) => s + o.price, 0);
        return BASE_PRICE + state.fabricDelta + state.frameDelta + state.sizeDelta + optsSum;
      };

      const getOldUnitPrice = () => {
        const optsSum = state.options.reduce((s, o) => s + o.price, 0);
        return BASE_OLD_PRICE + state.fabricDelta + state.frameDelta + state.sizeDelta + optsSum;
      };

      const syncAllPricesAndSummary = () => {
        const unit = getUnitPrice();
        const old = getOldUnitPrice();
        const savings = old - unit;
        const totalForQty = unit * state.qty;

        document.getElementById('displayPrice').textContent = formatRUB(unit);
        document.getElementById('displayOldPrice').textContent = formatRUB(old);
        document.getElementById('displaySavings').textContent = `Выгода ${formatRUB(savings)}`;
        document.getElementById('installmentValue').textContent = `4 × ${formatRUB(Math.round(unit / 4))}`;
        document.getElementById('addToCartPrice').textContent = `· ${formatRUB(totalForQty)}`;
        document.getElementById('stickyPriceText').textContent = formatRUB(unit);
        document.getElementById('stickySummaryText').textContent = `· ${state.fabric} · ${state.frame} · ${state.size}`;

        // Обновление вкладки характеристик
        document.getElementById('specSizeValue').textContent = `${state.size} (${state.dims.w} × ${state.dims.d} × ${state.dims.h} см)`;
        document.getElementById('specFabricValue').textContent = `${state.fabric} (${state.fabricCategory})`;
        document.getElementById('specFrameValue').textContent = state.frame;
      };

      // ==================== 1. ВЫБОР ОБИВКИ (6 ВАРИАНТОВ) ====================
      const primaryChairImage = document.getElementById('primaryChairImage');
      const sliderActiveImg = document.getElementById('sliderActiveImg');

      document.querySelectorAll('.fabric-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.fabric-btn').forEach((b) => {
            b.classList.remove('border-[#111111]', 'bg-[#FAFAFA]');
            b.classList.add('border-[#E5E5E5]', 'bg-white');
          });
          btn.classList.remove('border-[#E5E5E5]', 'bg-white');
          btn.classList.add('border-[#111111]', 'bg-[#FAFAFA]');

          state.fabric = btn.dataset.fabric;
          state.fabricCategory = btn.dataset.categoryLabel;
          state.fabricDelta = Number(btn.dataset.delta);
          state.fabricFilter = btn.dataset.filter;

          const deltaLabel = state.fabricDelta > 0 ? `+${formatRUB(state.fabricDelta)}` : 'База';
          document.getElementById('selectedFabricBadge').textContent = `${state.fabric} · ${deltaLabel}`;
          document.getElementById('photoFabricLabel').textContent = state.fabric;
          document.getElementById('photoSwatchDot').style.backgroundColor = btn.dataset.swatch;

          primaryChairImage.style.filter = state.fabricFilter;
          sliderActiveImg.style.filter = state.fabricFilter;
          syncAllPricesAndSummary();
        });
      });

      // ==================== 2. ВЫБОР КАРКАСА (4 ВАРИАНТА) ====================
      document.querySelectorAll('.frame-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.frame-btn').forEach((b) => {
            b.classList.remove('border-[#111111]', 'bg-[#FAFAFA]');
            b.classList.add('border-[#E5E5E5]', 'bg-white');
          });
          btn.classList.remove('border-[#E5E5E5]', 'bg-white');
          btn.classList.add('border-[#111111]', 'bg-[#FAFAFA]');

          state.frame = btn.dataset.frame;
          state.frameDelta = Number(btn.dataset.delta);
          document.getElementById('selectedFrameBadge').textContent = state.frame;
          syncAllPricesAndSummary();
        });
      });

      // ==================== 3. ВЫБОР РАЗМЕРА И ПЕРЕСЧЕТ ЧЕРТЕЖА ====================
      const updateDimensionsUI = () => {
        const mult = state.bpUnit === 'mm' ? 10 : 1;
        const unitLabel = state.bpUnit === 'mm' ? 'мм' : 'см';

        document.getElementById('miniDimW').textContent = `${state.dims.w} см`;
        document.getElementById('miniDimD').textContent = `${state.dims.d} см`;
        document.getElementById('miniDimH').textContent = `${state.dims.h} см`;

        document.getElementById('bpSizeTitle').textContent = `(${state.size})`;
        document.getElementById('svgDimW').textContent = `${state.dims.w * mult} ${unitLabel}`;
        document.getElementById('svgDimD').textContent = `${state.dims.d * mult} ${unitLabel}`;
        document.getElementById('svgDimH').textContent = `${state.dims.h * mult} ${unitLabel}`;
      };

      document.querySelectorAll('.size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.size-btn').forEach((b) => {
            b.classList.remove('border-[#111111]', 'bg-[#FAFAFA]');
            b.classList.add('border-[#E5E5E5]', 'bg-white');
          });
          btn.classList.remove('border-[#E5E5E5]', 'bg-white');
          btn.classList.add('border-[#111111]', 'bg-[#FAFAFA]');

          state.size = btn.dataset.size;
          state.sizeDelta = Number(btn.dataset.delta);
          state.dims = {
            w: Number(btn.dataset.w),
            d: Number(btn.dataset.d),
            h: Number(btn.dataset.h)
          };
          updateDimensionsUI();
          syncAllPricesAndSummary();
        });
      });

      // Переключатель см/мм на чертеже
      const bpCmBtn = document.getElementById('bpCmBtn');
      const bpMmBtn = document.getElementById('bpMmBtn');
      bpCmBtn.addEventListener('click', () => {
        state.bpUnit = 'cm';
        bpCmBtn.classList.add('bg-[#111111]', 'text-white');
        bpCmBtn.classList.remove('text-neutral-500');
        bpMmBtn.classList.remove('bg-[#111111]', 'text-white');
        bpMmBtn.classList.add('text-neutral-500');
        updateDimensionsUI();
      });
      bpMmBtn.addEventListener('click', () => {
        state.bpUnit = 'mm';
        bpMmBtn.classList.add('bg-[#111111]', 'text-white');
        bpMmBtn.classList.remove('text-neutral-500');
        bpCmBtn.classList.remove('bg-[#111111]', 'text-white');
        bpCmBtn.classList.add('text-neutral-500');
        updateDimensionsUI();
      });

      // ==================== 4. ДОПОЛНИТЕЛЬНЫЕ ОПЦИИ (ЧЕКБОКСЫ) ====================
      document.querySelectorAll('.extra-opt-cb').forEach((cb) => {
        cb.addEventListener('change', () => {
          state.options = Array.from(document.querySelectorAll('.extra-opt-cb:checked')).map((el) => ({
            name: el.dataset.optName,
            price: Number(el.dataset.optPrice)
          }));
          syncAllPricesAndSummary();
        });
      });

      // ==================== 5. КОЛИЧЕСТВО И КОРЗИНА ====================
      document.getElementById('qtyDecBtn').addEventListener('click', () => {
        if (state.qty > 1) {
          state.qty--;
          document.getElementById('qtyValueLabel').textContent = state.qty;
          syncAllPricesAndSummary();
        }
      });
      document.getElementById('qtyIncBtn').addEventListener('click', () => {
        if (state.qty < 9) {
          state.qty++;
          document.getElementById('qtyValueLabel').textContent = state.qty;
          syncAllPricesAndSummary();
        }
      });

      const cartDrawerBackdrop = document.getElementById('cartDrawerBackdrop');
      const cartDrawerPanel = document.getElementById('cartDrawerPanel');
      const cartItemsContainer = document.getElementById('cartItemsContainer');

      const openCart = () => {
        cartDrawerBackdrop.classList.remove('pointer-events-none', 'opacity-0');
        cartDrawerPanel.classList.remove('translate-x-full');
      };
      const closeCart = () => {
        cartDrawerBackdrop.classList.add('pointer-events-none', 'opacity-0');
        cartDrawerPanel.classList.add('translate-x-full');
      };

      document.getElementById('openCartBtn').addEventListener('click', openCart);
      document.getElementById('closeCartBtn').addEventListener('click', closeCart);
      cartDrawerBackdrop.addEventListener('click', (e) => {
        if (e.target === cartDrawerBackdrop) closeCart();
      });

      const renderCart = () => {
        const totalQty = state.cart.reduce((s, i) => s + i.qty, 0);
        const subtotal = state.cart.reduce((s, i) => s + i.price * i.qty, 0);
        const discount = state.promoPercent > 0 ? Math.round(subtotal * (state.promoPercent / 100)) : 0;

        document.getElementById('cartBadge').textContent = totalQty;
        document.getElementById('drawerCountLabel').textContent = `(${totalQty})`;
        document.getElementById('cartTotalSum').textContent = formatRUB(subtotal - discount);

        const promoRow = document.getElementById('cartPromoRow');
        if (discount > 0) {
          promoRow.classList.remove('hidden');
          promoRow.classList.add('flex');
          document.getElementById('cartPromoTitle').textContent = `Промокод ${state.promoCode} (-${state.promoPercent}%)`;
          document.getElementById('cartPromoAmount').textContent = `-${formatRUB(discount)}`;
        } else {
          promoRow.classList.add('hidden');
        }

        if (!state.cart.length) {
          cartItemsContainer.innerHTML = `<div class="py-16 text-center text-xs text-neutral-400">Корзина пуста</div>`;
          return;
        }

        cartItemsContainer.innerHTML = state.cart.map((item, idx) => `
          <div class="py-5 flex items-start justify-between gap-4">
            <div class="min-w-0">
              <div class="font-display font-semibold text-sm text-[#111111]">${item.name}</div>
              <div class="text-xs text-neutral-500 mt-0.5 leading-relaxed">${item.meta}</div>
              <div class="mt-3 inline-flex items-center rounded-lg border border-[#E5E5E5] font-mono text-xs">
                <button type="button" data-cdec="${idx}" class="px-2.5 py-1 hover:bg-[#FAFAFA]">−</button>
                <span class="px-2 font-semibold">${item.qty}</span>
                <button type="button" data-cinc="${idx}" class="px-2.5 py-1 hover:bg-[#FAFAFA]">+</button>
              </div>
            </div>
            <div class="text-right shrink-0">
              <div class="font-mono text-sm font-semibold tabular">${formatRUB(item.price * item.qty)}</div>
              <button type="button" data-cdel="${idx}" class="mt-3 text-[11px] text-neutral-400 hover:text-[#DC2626] transition-colors">Удалить</button>
            </div>
          </div>
        `).join('');

        cartItemsContainer.querySelectorAll('[data-cdec]').forEach((b) => b.addEventListener('click', () => {
          const i = Number(b.dataset.cdec);
          state.cart[i].qty > 1 ? state.cart[i].qty-- : state.cart.splice(i, 1);
          renderCart();
        }));
        cartItemsContainer.querySelectorAll('[data-cinc]').forEach((b) => b.addEventListener('click', () => {
          state.cart[Number(b.dataset.cinc)].qty++;
          renderCart();
        }));
        cartItemsContainer.querySelectorAll('[data-cdel]').forEach((b) => b.addEventListener('click', () => {
          state.cart.splice(Number(b.dataset.cdel), 1);
          renderCart();
        }));
      };

      const addToCart = (item) => {
        const found = state.cart.find((x) => x.id === item.id);
        found ? (found.qty += item.qty) : state.cart.push(item);
        renderCart();
      };

      const addToCartBtn = document.getElementById('addToCartBtn');
      const addToCartText = document.getElementById('addToCartText');

      const handleMainAddToCart = () => {
        var ocId = document.getElementById('oc-product-id');
        if (ocId && ocId.value) {
          var body = new URLSearchParams();
          body.set('product_id', ocId.value);
          body.set('quantity', String(state.qty));
          fetch('index.php?route=checkout/cart/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
            body: body.toString()
          }).then(function (r) { return r.json(); }).then(function (json) {
            if (json && json.error && json.error.option) {
              showToast('Выберите опции товара в карточке магазина', 'red');
            }
          }).catch(function () {});
        }
        const optNames = state.options.map((o) => o.name);
        const metaParts = [state.fabric, state.frame, state.size, ...optNames];
        addToCart({
          id: `aero04-${metaParts.join('-')}`,
          name: 'NORDIC FORM — AERO 04',
          meta: metaParts.join(' · '),
          price: getUnitPrice(),
          qty: state.qty
        });

        addToCartBtn.classList.add('btn-confirmed');
        addToCartText.textContent = 'Добавлено в корзину ✓';
        showToast(`Добавлено в корзину (${state.qty} шт.)`, 'green');

        setTimeout(() => {
          addToCartBtn.classList.remove('btn-confirmed');
          addToCartText.textContent = 'Добавить в корзину';
        }, 1400);
      };

      addToCartBtn.addEventListener('click', handleMainAddToCart);
      document.getElementById('stickyAddBtn').addEventListener('click', handleMainAddToCart);

      // Промокоды в корзине (NORDIC10 / AERO15)
      document.getElementById('cartPromoApplyBtn').addEventListener('click', () => {
        const code = document.getElementById('cartPromoInput').value.trim().toUpperCase();
        if (code === 'NORDIC10') {
          state.promoCode = 'NORDIC10';
          state.promoPercent = 10;
          renderCart();
          showToast('Промокод NORDIC10 применен (-10%)', 'green');
        } else if (code === 'AERO15') {
          state.promoCode = 'AERO15';
          state.promoPercent = 15;
          renderCart();
          showToast('Промокод AERO15 применен (-15%)', 'green');
        } else {
          showToast('Неверный промокод (попробуйте NORDIC10 или AERO15)', 'red');
        }
      });

      document.getElementById('checkoutBtn').addEventListener('click', () => {
        if (!state.cart.length) return;
        closeCart();
        showToast('Заказ оформлен — менеджер свяжется с вами', 'green');
      });

      // Сопутствующие товары
      document.querySelectorAll('.companion-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          addToCart({
            id: btn.dataset.cId,
            name: btn.dataset.cName,
            meta: btn.dataset.cMeta,
            price: Number(btn.dataset.cPrice),
            qty: 1
          });
          const orig = btn.textContent;
          btn.textContent = 'Добавлено ✓';
          btn.classList.add('border-[#16A34A]', 'text-[#16A34A]');
          showToast(`${btn.dataset.cName} добавлен в корзину`, 'green');
          setTimeout(() => {
            btn.textContent = orig;
            btn.classList.remove('border-[#16A34A]', 'text-[#16A34A]');
          }, 1200);
        });
      });

      // ==================== 6. ИЗБРАННОЕ И КУПИТЬ В 1 КЛИК ====================
      const toggleWishlist = () => {
        state.wishlisted = !state.wishlisted;
        const cardSvg = document.getElementById('cardWishSvg');
        const headerSvg = document.getElementById('headerWishSvg');
        const headerCount = document.getElementById('headerWishCount');

        if (state.wishlisted) {
          cardSvg.classList.add('text-[#DC2626]', 'fill-[#DC2626]', 'scale-110');
          headerSvg.classList.add('text-[#DC2626]', 'fill-[#DC2626]');
          headerCount.classList.remove('hidden');
          showToast('Добавлено в избранное', 'red');
        } else {
          cardSvg.classList.remove('text-[#DC2626]', 'fill-[#DC2626]', 'scale-110');
          headerSvg.classList.remove('text-[#DC2626]', 'fill-[#DC2626]');
          headerCount.classList.add('hidden');
          showToast('Удалено из избранного', 'red');
        }
      };
      document.getElementById('cardWishBtn').addEventListener('click', toggleWishlist);
      document.getElementById('headerWishBtn').addEventListener('click', toggleWishlist);

      const oneClickModal = document.getElementById('oneClickModal');
      document.getElementById('oneClickBtn').addEventListener('click', () => {
        document.getElementById('oneClickSummary').textContent = `${state.fabric} · ${state.frame} · ${state.size} · ${formatRUB(getUnitPrice() * state.qty)}`;
        oneClickModal.classList.remove('hidden');
        oneClickModal.classList.add('flex');
      });
      document.getElementById('closeOneClickBtn').addEventListener('click', () => {
        oneClickModal.classList.add('hidden');
        oneClickModal.classList.remove('flex');
      });
      document.getElementById('oneClickForm').addEventListener('submit', (e) => {
        e.preventDefault();
        oneClickModal.classList.add('hidden');
        oneClickModal.classList.remove('flex');
        showToast('Заявка в 1 клик принята', 'green');
      });

      // ==================== 7. ГАЛЕРЕЯ, СЛАЙДЕР И ЛАЙТБОКС ====================
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.08 });
      document.querySelectorAll('.reveal-card').forEach((el) => observer.observe(el));

      // Фильтрация ракурсов
      document.querySelectorAll('.view-filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.view-filter-btn').forEach((b) => {
            b.classList.remove('bg-[#111111]', 'text-white');
            b.classList.add('bg-transparent', 'text-neutral-500');
          });
          btn.classList.remove('bg-transparent', 'text-neutral-500');
          btn.classList.add('bg-[#111111]', 'text-white');

          const view = btn.dataset.view;
          document.querySelectorAll('.gallery-card').forEach((card) => {
            card.classList.toggle('hidden', view !== 'all' && card.dataset.category !== view);
          });
        });
      });

      // Слайдер (для режимов slider-left и slider-bottom)
      const sliderThumbsContainer = document.getElementById('sliderThumbsContainer');
      const updateSliderView = (idx) => {
        state.activeSlide = (idx + galleryData.length) % galleryData.length;
        const item = galleryData[state.activeSlide];
        sliderActiveImg.src = item.src;
        sliderActiveImg.style.filter = state.fabricFilter;
        document.getElementById('sliderCaption').textContent = item.caption;
        document.getElementById('sliderCounter').textContent = `${state.activeSlide + 1} / ${galleryData.length}`;

        sliderThumbsContainer.querySelectorAll('button').forEach((b, i) => {
          b.classList.toggle('border-[#111111]', i === state.activeSlide);
          b.classList.toggle('opacity-100', i === state.activeSlide);
          b.classList.toggle('border-[#E5E5E5]', i !== state.activeSlide);
          b.classList.toggle('opacity-60', i !== state.activeSlide);
        });
      };

      sliderThumbsContainer.innerHTML = galleryData.map((g, i) => `
        <button type="button" data-sidx="${i}" class="w-16 h-16 rounded-lg border ${i === 0 ? 'border-[#111111] opacity-100' : 'border-[#E5E5E5] opacity-60'} overflow-hidden bg-[#F5F5F4] transition-all shrink-0">
          <img src="${g.src}" alt="Миниатюра ${i + 1}" class="w-full h-full object-cover" />
        </button>
      `).join('');

      sliderThumbsContainer.querySelectorAll('button').forEach((b) => {
        b.addEventListener('click', () => updateSliderView(Number(b.dataset.sidx)));
      });
      document.getElementById('sliderPrevBtn').addEventListener('click', () => updateSliderView(state.activeSlide - 1));
      document.getElementById('sliderNextBtn').addEventListener('click', () => updateSliderView(state.activeSlide + 1));

      // Лайтбокс
      const lightboxModal = document.getElementById('lightboxModal');
      const openLightbox = (index) => {
        state.lightboxIndex = (index + galleryData.length) % galleryData.length;
        const item = galleryData[state.lightboxIndex];
        const lbImg = document.getElementById('lightboxImg');
        lbImg.src = item.src;
        lbImg.style.filter = state.fabricFilter;
        document.getElementById('lightboxCaption').textContent = item.caption;
        document.getElementById('lightboxCounter').textContent = `${state.lightboxIndex + 1} / ${galleryData.length}`;
        lightboxModal.classList.remove('hidden');
        lightboxModal.classList.add('flex');
      };

      document.querySelectorAll('.gallery-frame').forEach((frame) => {
        frame.addEventListener('click', () => openLightbox(Number(frame.dataset.index || 0)));
      });
      document.getElementById('sliderMainStage').addEventListener('click', (e) => {
        if (e.target.closest('button')) return;
        openLightbox(state.activeSlide);
      });
      document.getElementById('lbPrevBtn').addEventListener('click', () => openLightbox(state.lightboxIndex - 1));
      document.getElementById('lbNextBtn').addEventListener('click', () => openLightbox(state.lightboxIndex + 1));
      document.getElementById('closeLightboxBtn').addEventListener('click', () => {
        lightboxModal.classList.add('hidden');
        lightboxModal.classList.remove('flex');
      });
      document.addEventListener('keydown', (e) => {
        if (lightboxModal.classList.contains('hidden')) return;
        if (e.key === 'Escape') {
          lightboxModal.classList.add('hidden');
          lightboxModal.classList.remove('flex');
        } else if (e.key === 'ArrowLeft') {
          openLightbox(state.lightboxIndex - 1);
        } else if (e.key === 'ArrowRight') {
          openLightbox(state.lightboxIndex + 1);
        }
      });

      // ==================== 8. ВКЛАДКИ ПОД ГАЛЕРЕЕЙ И ОТЗЫВЫ ====================
      const activateDetailTab = (tabName) => {
        document.querySelectorAll('.detail-tab-btn').forEach((b) => {
          const active = b.dataset.tab === tabName;
          b.classList.toggle('border-[#111111]', active);
          b.classList.toggle('text-[#111111]', active);
          b.classList.toggle('border-transparent', !active);
          b.classList.toggle('text-neutral-500', !active);
        });
        document.querySelectorAll('.detail-pane').forEach((p) => {
          if (p.id === `pane-${tabName}`) {
            p.classList.remove('hidden');
            p.classList.add('tab-pane-active');
          } else {
            p.classList.add('hidden');
          }
        });
      };

      document.querySelectorAll('.detail-tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => activateDetailTab(btn.dataset.tab));
      });
      document.getElementById('jumpToBlueprintBtn').addEventListener('click', () => {
        activateDetailTab('blueprint');
        document.getElementById('detailsTabsSection').scrollIntoView({ behavior: 'smooth' });
      });

      let reviewCount = 24;
      document.getElementById('reviewSubmitForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const author = document.getElementById('revAuthorInput').value.trim();
        const rating = document.getElementById('revRatingInput').value;
        const text = document.getElementById('revTextInput').value.trim();
        if (!author || !text) return;

        const art = document.createElement('article');
        art.className = 'p-4 rounded-xl bg-[#FAFAFA] border border-[#16A34A] space-y-2 tab-pane-active';
        art.innerHTML = `
          <div class="flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-[#111111]">${author}</span>
              <span class="px-2 py-0.5 rounded-full bg-[#16A34A]/10 text-[#16A34A] text-[10px] font-medium">✓ Новый отзыв</span>
            </div>
            <span class="font-mono text-[11px] text-neutral-400">Только что</span>
          </div>
          <div class="text-xs text-neutral-500">${rating} · ${state.fabric} · ${state.frame}</div>
          <p class="text-xs text-neutral-700 leading-relaxed">${text}</p>
        `;
        document.getElementById('reviewsList').prepend(art);
        reviewCount++;
        document.getElementById('tabReviewsCounter').textContent = reviewCount;
        e.target.reset();
        showToast('Отзыв опубликован', 'green');
      });

      // ==================== 9. ПОИСК ПО КАТАЛОГУ В ШАПКЕ ====================
      const searchCatalog = [
        { title: 'Лаунж-кресло AERO 04', cat: 'Текущий товар', price: '89 000 ₽', anchor: '#' },
        { title: 'Пуф-оттоманка AERO Ottoman', cat: 'Комплект', price: '19 500 ₽', anchor: '#companionSection' },
        { title: 'Торшер KOBE Paper & Steel', cat: 'Освещение', price: '24 500 ₽', anchor: '#companionSection' },
        { title: 'Приставной столик SORA Oak', cat: 'Столы', price: '21 000 ₽', anchor: '#companionSection' },
        { title: 'Плед KYOTO Merino 140×200', cat: 'Текстиль', price: '12 900 ₽', anchor: '#companionSection' }
      ];
      const searchInput = document.getElementById('catalogSearchInput');
      const searchDropdown = document.getElementById('searchDropdown');

      searchInput.addEventListener('input', () => {
        const q = searchInput.value.trim().toLowerCase();
        if (!q) {
          searchDropdown.classList.add('hidden');
          return;
        }
        const matches = searchCatalog.filter((x) => x.title.toLowerCase().includes(q) || x.cat.toLowerCase().includes(q));
        if (!matches.length) {
          searchDropdown.innerHTML = `<div class="p-3 text-xs text-neutral-400">Ничего не найдено</div>`;
        } else {
          searchDropdown.innerHTML = matches.map((m) => `
            <a href="${m.anchor}" class="flex items-center justify-between px-3.5 py-2.5 hover:bg-[#FAFAFA] border-b last:border-b-0 border-[#E5E5E5] text-xs">
              <div>
                <div class="font-medium text-[#111111]">${m.title}</div>
                <div class="text-[10px] text-neutral-400">${m.cat}</div>
              </div>
              <span class="font-mono font-semibold text-[#111111]">${m.price}</span>
            </a>
          `).join('');
        }
        searchDropdown.classList.remove('hidden');
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#catalogSearchInput') && !e.target.closest('#searchDropdown')) {
          searchDropdown.classList.add('hidden');
        }
      });

      // ==================== 10. ПАНЕЛЬ НАСТРОЕК ИНТЕРФЕЙСА (CUSTOMIZER) ====================
      const customizerBackdrop = document.getElementById('customizerBackdrop');
      const customizerPanel = document.getElementById('customizerPanel');

      document.getElementById('openCustomizerBtn').addEventListener('click', () => {
        customizerBackdrop.classList.remove('pointer-events-none', 'opacity-0');
        customizerPanel.classList.remove('translate-x-full');
      });
      const closeCustomizer = () => {
        customizerBackdrop.classList.add('pointer-events-none', 'opacity-0');
        customizerPanel.classList.add('translate-x-full');
      };
      document.getElementById('closeCustomizerBtn').addEventListener('click', closeCustomizer);
      customizerBackdrop.addEventListener('click', (e) => {
        if (e.target === customizerBackdrop) closeCustomizer();
      });

      // Вкладки внутри панели настроек
      document.querySelectorAll('.cust-tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cust-tab-btn').forEach((b) => {
            b.classList.remove('border-[#111111]', 'font-semibold', 'text-[#111111]');
            b.classList.add('border-transparent', 'text-neutral-500');
          });
          btn.classList.remove('border-transparent', 'text-neutral-500');
          btn.classList.add('border-[#111111]', 'font-semibold', 'text-[#111111]');

          document.querySelectorAll('.cust-pane').forEach((p) => {
            p.classList.toggle('hidden', p.id !== `cust-pane-${btn.dataset.ctab}`);
          });
        });
      });

      // Применение всех настроек в реальном времени и подсчет изменений
      const applyCustomizerState = () => {
        let changes = 0;
        if (state.ui.galleryMode !== 'grid') changes++;
        if (state.ui.radius !== '14') changes++;
        if (state.ui.borderStyle !== 'hairline') changes++;
        if (state.ui.accent !== '#111111') changes++;
        if (state.ui.density !== 'expanded') changes++;
        Object.values(state.ui.toggles).forEach((val) => { if (!val) changes++; });

        const badge = document.getElementById('customizerChangedBadge');
        document.getElementById('panelChangesCounter').textContent = `${changes} изм.`;
        if (changes > 0) {
          badge.textContent = changes;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }

        // 1. Раскладка галереи
        const gridEl = document.getElementById('galleryLayoutGrid');
        const sliderEl = document.getElementById('galleryLayoutSlider');
        const thumbsEl = document.getElementById('sliderThumbsContainer');
        if (state.ui.galleryMode === 'grid') {
          gridEl.classList.remove('hidden');
          sliderEl.classList.add('hidden');
          sliderEl.classList.remove('flex');
        } else {
          gridEl.classList.add('hidden');
          sliderEl.classList.remove('hidden');
          sliderEl.classList.add('flex');
          if (state.ui.galleryMode === 'slider-left') {
            sliderEl.classList.remove('flex-col-reverse');
            sliderEl.classList.add('flex-col', 'sm:flex-row');
            thumbsEl.classList.remove('flex-row', 'overflow-x-auto');
            thumbsEl.classList.add('flex-row', 'sm:flex-col');
          } else {
            sliderEl.classList.remove('sm:flex-row');
            sliderEl.classList.add('flex-col-reverse');
            thumbsEl.classList.remove('sm:flex-col');
            thumbsEl.classList.add('flex-row', 'overflow-x-auto');
          }
        }

        // 2. Скругление углов
        document.documentElement.style.setProperty('--ui-radius', `${state.ui.radius}px`);
        document.documentElement.style.setProperty('--ui-radius-sm', `${Math.max(0, Number(state.ui.radius) - 4)}px`);

        // 3. Границы
        if (state.ui.borderStyle === 'air') {
          document.documentElement.style.setProperty('--ui-border-color', 'transparent');
        } else if (state.ui.borderStyle === 'contrast') {
          document.documentElement.style.setProperty('--ui-border-color', '#111111');
        } else {
          document.documentElement.style.setProperty('--ui-border-color', '#E5E5E5');
        }

        // 4. Акцент главной кнопки
        const hoverMap = { '#111111': '#262626', '#16A34A': '#15803D', '#DC2626': '#B91C1C' };
        document.documentElement.style.setProperty('--ui-btn-accent', state.ui.accent);
        document.documentElement.style.setProperty('--ui-btn-accent-hover', hoverMap[state.ui.accent] || '#262626');

        // 5. Переключатели видимости блоков
        document.querySelectorAll('.discount-element').forEach((el) => el.classList.toggle('hidden', !state.ui.toggles.discount));
        document.getElementById('stockUrgencyBlock').classList.toggle('hidden', !state.ui.toggles.urgency);
        document.getElementById('freeShippingBlock').classList.toggle('hidden', !state.ui.toggles.shipping);
        document.getElementById('oneClickBtn').classList.toggle('hidden', !state.ui.toggles.oneclick);
        document.getElementById('installmentBlock').classList.toggle('hidden', !state.ui.toggles.installment);

        // 6. Компактный / Расширенный режим + мини-чертеж
        const isCompact = state.ui.density === 'compact';
        document.getElementById('extraOptionsSection').classList.toggle('hidden', isCompact);
        document.getElementById('cardBlueprintWidget').classList.toggle('hidden', isCompact || !state.ui.toggles.blueprint);
      };

      // Слушатели кнопок настроек
      document.querySelectorAll('.cfg-gallery-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cfg-gallery-btn').forEach((b) => {
            b.classList.remove('border-[#111111]', 'bg-[#FAFAFA]');
            b.classList.add('border-[#E5E5E5]', 'bg-white');
            b.querySelector('span:last-child').classList.replace('bg-[#16A34A]', 'bg-transparent');
          });
          btn.classList.remove('border-[#E5E5E5]', 'bg-white');
          btn.classList.add('border-[#111111]', 'bg-[#FAFAFA]');
          btn.querySelector('span:last-child').classList.replace('bg-transparent', 'bg-[#16A34A]');
          state.ui.galleryMode = btn.dataset.galleryMode;
          applyCustomizerState();
        });
      });

      document.querySelectorAll('.cfg-radius-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cfg-radius-btn').forEach((b) => {
            b.classList.remove('border-[#111111]', 'bg-[#FAFAFA]', 'font-semibold');
            b.classList.add('border-[#E5E5E5]', 'bg-white');
          });
          btn.classList.remove('border-[#E5E5E5]', 'bg-white');
          btn.classList.add('border-[#111111]', 'bg-[#FAFAFA]', 'font-semibold');
          state.ui.radius = btn.dataset.radius;
          applyCustomizerState();
        });
      });

      document.querySelectorAll('.cfg-border-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cfg-border-btn').forEach((b) => {
            b.classList.remove('border-[#111111]', 'bg-[#FAFAFA]', 'font-semibold');
            b.classList.add('border-[#E5E5E5]', 'bg-white');
          });
          btn.classList.remove('border-[#E5E5E5]', 'bg-white');
          btn.classList.add('border-[#111111]', 'bg-[#FAFAFA]', 'font-semibold');
          state.ui.borderStyle = btn.dataset.borderStyle;
          applyCustomizerState();
        });
      });

      document.querySelectorAll('.cfg-accent-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cfg-accent-btn').forEach((b) => {
            b.classList.remove('border-[#111111]', 'bg-[#FAFAFA]');
            b.classList.add('border-[#E5E5E5]', 'bg-white');
          });
          btn.classList.remove('border-[#E5E5E5]', 'bg-white');
          btn.classList.add('border-[#111111]', 'bg-[#FAFAFA]');
          state.ui.accent = btn.dataset.accent;
          applyCustomizerState();
        });
      });

      document.querySelectorAll('.cfg-toggle').forEach((cb) => {
        cb.addEventListener('change', () => {
          state.ui.toggles[cb.dataset.toggleTarget] = cb.checked;
          applyCustomizerState();
        });
      });

      document.querySelectorAll('.cfg-density-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cfg-density-btn').forEach((b) => {
            b.classList.remove('border-[#111111]', 'bg-[#FAFAFA]');
            b.classList.add('border-[#E5E5E5]', 'bg-white');
          });
          btn.classList.remove('border-[#E5E5E5]', 'bg-white');
          btn.classList.add('border-[#111111]', 'bg-[#FAFAFA]');
          state.ui.density = btn.dataset.density;
          applyCustomizerState();
        });
      });

      // Сброс настроек
      document.getElementById('resetCustomizerBtn').addEventListener('click', () => {
        state.ui = {
          galleryMode: 'grid',
          radius: '14',
          borderStyle: 'hairline',
          accent: '#111111',
          density: 'expanded',
          toggles: { discount: true, urgency: true, shipping: true, oneclick: true, installment: true, blueprint: true }
        };
        document.querySelectorAll('.cfg-toggle').forEach((cb) => { cb.checked = true; });
        document.querySelector('.cfg-gallery-btn[data-gallery-mode="grid"]').click();
        document.querySelector('.cfg-radius-btn[data-radius="14"]').click();
        document.querySelector('.cfg-border-btn[data-border-style="hairline"]').click();
        document.querySelector('.cfg-accent-btn[data-accent="#111111"]').click();
        document.querySelector('.cfg-density-btn[data-density="expanded"]').click();
        showToast('Настройки интерфейса сброшены', 'red');
      });

      // ==================== 11. STICKY BOTTOM BAR ПРИ СКРОЛЛЕ ====================
      const stickyBottomBar = document.getElementById('stickyBottomBar');
      window.addEventListener('scroll', () => {
        const rect = addToCartBtn.getBoundingClientRect();
        stickyBottomBar.classList.toggle('translate-y-full', rect.bottom >= 0);
      }, { passive: true });

      renderCart();
      syncAllPricesAndSummary();
    });
  </script>
</body>
</html>