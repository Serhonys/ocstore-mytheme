{{ header }}
<main class="layout" id="common-success">
  {{ column_left }}
  <div id="content" class="layout-main">
    <ul class="crumbs">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    {{ content_top }}
    <h1>{{ heading_title }}</h1>
    {{ text_message }}
    <p class="actions"><a class="btn" href="{{ continue }}">{{ button_continue }}</a></p>
    {{ content_bottom }}
  </div>
  {{ column_right }}
</main>
{{ footer }}
