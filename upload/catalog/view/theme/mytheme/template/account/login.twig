{{ header }}
<main class="layout" id="account-login">
  {{ column_left }}
  <div id="content" class="layout-main">
    <ul class="crumbs">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    {{ content_top }}
    <div class="split">
      <section class="side-block">
        <h1>{{ text_new_customer }}</h1>
        <p><strong>{{ text_register }}</strong></p>
        <p>{{ text_register_account }}</p>
        <a class="btn" href="{{ register }}">{{ button_continue }}</a>
      </section>
      <section class="side-block">
        <h2>{{ text_returning_customer }}</h2>
        <p>{{ text_i_am_returning_customer }}</p>
        <form action="{{ action }}" method="post" enctype="multipart/form-data">
          <div class="field">
            <label for="input-email">{{ entry_email }}</label>
            <input type="text" name="email" value="{{ email }}" id="input-email" />
          </div>
          <div class="field">
            <label for="input-password">{{ entry_password }}</label>
            <input type="password" name="password" value="{{ password }}" id="input-password" />
            <a href="{{ forgotten }}">{{ text_forgotten }}</a>
          </div>
          <input class="btn" type="submit" value="{{ button_login }}" />
          {% if redirect %}<input type="hidden" name="redirect" value="{{ redirect }}" />{% endif %}
        </form>
      </section>
    </div>
    {{ content_bottom }}
  </div>
  {{ column_right }}
</main>
{{ footer }}
